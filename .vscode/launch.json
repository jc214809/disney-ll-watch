{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serve Site",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 -m http.server 8743 --directory .",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8743",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Serve + Open in Chrome",
      "configurations": ["Serve Site", "Open in Chrome"],
      "stopAll": true
    }
  ]
}
